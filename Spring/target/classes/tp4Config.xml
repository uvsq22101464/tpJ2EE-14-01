<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans 
	http://www.springframework.org/schema/beans/spring-beans-2.0.xsd">
	
	
	
	
	<bean id="id" class="fr.uvsq.spring.tp4.entity.Identite"/>
	<bean id="app" class="fr.uvsq.spring.tp4.entity.Application" autowire="byName"/>
	<bean id="fournisseur" class="fr.uvsq.spring.tp4.entity.Fournisseur" autowire="constructor">
		<property name="nom" value="Auchan"/>
	</bean>
	
	<bean id="adresse" class="fr.uvsq.spring.tp4.entity.Adresse">
		<property name="rue" value="etats unies"/>
		<property name="ville" value="Versailles"/>
	</bean>
	<bean id="identite" class="fr.uvsq.spring.tp4.entity.Identite" autowire="byType"/>
	
	<bean id="siret" class="fr.uvsq.spring.tp4.entity.Reference">
		<property name="siret" value="765444"/>
	</bean>
	
		
</beans>